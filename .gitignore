# 运行时日志
/logs/
/debug/
/assets/debug/

# Python 缓存
__pycache__/
*.pyc

# 运行时生成目录（首次启动自动创建）
/config/
/backup/
/temp/
/appsettings.json

# 刀帐个人数据（由运行时写入 config/，不提交到 Git）
/config/config.json
/config/mfa_*.json
/config/swordbook_scan.json

# 本地运行配置（含本机模拟器路径，不随仓库分发）
/assets/config/
/assets/resource/base/image/unused/

# NuGet 输出（publish 时自动生成）
/libs/
/plugins/

# 本地运行时库（pack.ps1 打包时从本地读取，不随仓库分发）
/runtimes/

# 根目录发布产物（dotnet publish 后手动拷贝，仅用于 pack.ps1 打包）
/matr.exe
/MATR.dll
/MFAAvalonia.Core.dll
/MATR.deps.json
/MATR.runtimeconfig.json
/libloader.dll

# 构建产物（clean_build.ps1 清理对象）
**/bin/
**/obj/

# .NET SDK Resolver 临时备份文件
*.csproj.SdkResolver.*.proj.Backup.tmp

# IDE 个人设置（.vscode/ 等仓库级共享配置仍跟踪）
/.idea/
/.vs/
*.user
*.suo
*.DotSettings.user

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 本地项目文档(仅 docs/分支流程.md 随仓库分发)
/docs/*
!/docs/分支流程.md

# 打包产物
/MATR-*.zip
/MATR-*/
/MATR.app/
/_temp_zip/

# Codex 工作文件(不随仓库分发)
.agents/
AGENTS.md
findings.md
progress.md
task_plan.md

# Claude Code 本地配置与指令(不随仓库分发)
/.claude/
/CLAUDE.md

# 误生成空文件（构建时 XamlCompiler 偶发把表达式写成空文件名）
entry()
o.Name
start
()
,+
0
