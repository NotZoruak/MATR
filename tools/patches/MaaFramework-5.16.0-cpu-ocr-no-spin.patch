+bool configure_cpu_ocr_session(OrtSessionOptions* options, void*)
+{
+    // 回调接管会话配置，保留四个推理线程并关闭 CPU 会话空闲自旋。
+    const auto* api = OrtGetApiBase()->GetApi(ORT_API_VERSION);
+    if (!api) {
+        LogError << "无法取得 OCR 的 ONNX Runtime 接口";
+        return false;
+    }
+    const auto check = [api](OrtStatus* status) {
+        if (!status) {
+            return true;
+        }
+        LogError << "配置 CPU OCR 会话失败" << api->GetErrorMessage(status);
+        api->ReleaseStatus(status);
+        return false;
+    };
+    return check(api->SetIntraOpNumThreads(options, 4))
+        && check(api->AddSessionConfigEntry(options, "session.intra_op.allow_spinning", "0"))
+        && check(api->AddSessionConfigEntry(options, "session.inter_op.allow_spinning", "0"));
+}
+} // 匿名命名空间
+
