{
  "UpdateData": {
    "next": ["UD_IsIntervalDue", "UD_IntervalSkipped"],
    "on_error": ["UD_DetectWhereAmI"]
  },
  "UD_IsIntervalDue": {
    "recognition": {
      "type": "Custom",
      "param": {
        "custom_recognition": "UpdateDataIntervalRecognition",
        "custom_recognition_param": {
          "interval": "每天",
          "key": "范围:仓库+刀帐"
        }
      }
    },
    "pre_delay": 0,
    "post_delay": 0,
    "next": ["UD_DetectWhereAmI"]
  },
  "UD_IntervalSkipped": {},
  "UD_DetectWhereAmI": {
    "timeout": 120000,
    "next": [
      "[JumpBack]IsExpeditionReturn_Exp",
      "[JumpBack]IsExpeditionReturn_Title",
      "[JumpBack]IsAnnouncementPopup",
      "IsTeamStatusPanel",
      "[JumpBack]IsAdvertisementPopup",
      "[JumpBack]IsTrainingLetter",
      "[JumpBack]IsLoginReward",
      "[JumpBack]IsGameIcon",
      "[JumpBack]IsLoginButton",
      "[JumpBack]IsGameUpdatePopup",
      "[JumpBack]IsInGameUpdatePopup",
      "[JumpBack]IsInternalReport",
      "[JumpBack]IsNetworkRequestTimeout",
      "[JumpBack]IsConnectionInterrupted",
      "UD_CheckHomeBrightness1",
      "[JumpBack]FallbackWait"
    ],
    "on_error": ["UD_RestartGame"]
  },
  "UD_CheckHomeBrightness1": {
    "recognition": {
      "type": "ColorMatch",
      "param": {
        "roi": [66, 58, 11, 13],
        "lower": [23, 95, 15],
        "upper": [40, 155, 30]
      }
    },
    "next": ["UD_IsHome1", "UD_DetectWhereAmI"]
  },
  "UD_IsHome1": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "roi": [8, 1, 71, 107],
        "template": "Common/本丸.png",
        "green_mask": true,
        "threshold": [0.98]
      }
    },
    "action": {
      "type": "Custom",
      "custom_action": "UpdateDataWaitAction",
      "custom_action_param": {"milliseconds": 1000}
    },
    "next": ["UD_CheckHomeBrightness2", "UD_DetectWhereAmI"]
  },
  "UD_CheckHomeBrightness2": {
    "recognition": {
      "type": "ColorMatch",
      "param": {
        "roi": [66, 58, 11, 13],
        "lower": [23, 95, 15],
        "upper": [40, 155, 30]
      }
    },
    "next": ["UD_IsHome2", "UD_DetectWhereAmI"]
  },
  "UD_IsHome2": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "roi": [8, 1, 71, 107],
        "template": "Common/本丸.png",
        "green_mask": true,
        "threshold": [0.98]
      }
    },
    "action": {
      "type": "Custom",
      "custom_action": "UpdateDataWaitAction",
      "custom_action_param": {"milliseconds": 1000}
    },
    "next": ["UD_RunWarehouse", "UD_RunSwordBook"]
  },
  "UD_RunWarehouse": {
    "action": {
      "type": "Custom",
      "custom_action": "UpdateDataPrepareAction",
      "custom_action_param": {"stage": "warehouse"}
    },
    "next": ["Warehouse_Start"]
  },
  "UD_SaveWarehouse": {
    "action": {
      "type": "Custom",
      "custom_action": "UpdateDataSaveAction",
      "custom_action_param": {"stage": "warehouse"}
    },
    "next": ["UD_ReturnHome"]
  },
  "UD_ReturnHome": {
    "next": ["UD_ReturnHomeX", "UD_ReturnHomeLowerX", "UD_ReturnHomeUpperX", "UD_ReturnHomeDone"],
    "on_error": ["UD_DetectWhereAmI"]
  },
  "UD_ReturnHomeX": {
    "recognition": {
      "type": "OCR",
      "param": {
        "roi": [1234, 9, 37, 38],
        "expected": "×"
      }
    },
    "action": {
      "type": "Click",
      "param": {"target": true}
    },
    "post_wait_freezes": {
      "time": 300,
      "target": [1234, 9, 37, 38]
    },
    "next": ["UD_ReturnHome"],
    "on_error": ["UD_ReturnHomeLowerX"]
  },
  "UD_ReturnHomeLowerX": {
    "recognition": {
      "type": "OCR",
      "param": {
        "roi": [1234, 9, 37, 38],
        "expected": "x"
      }
    },
    "action": {
      "type": "Click",
      "param": {"target": true}
    },
    "post_wait_freezes": {
      "time": 300,
      "target": [1234, 9, 37, 38]
    },
    "next": ["UD_ReturnHome"],
    "on_error": ["UD_ReturnHomeUpperX"]
  },
  "UD_ReturnHomeUpperX": {
    "recognition": {
      "type": "OCR",
      "param": {
        "roi": [1234, 9, 37, 38],
        "expected": "X"
      }
    },
    "action": {
      "type": "Click",
      "param": {"target": true}
    },
    "post_wait_freezes": {
      "time": 300,
      "target": [1234, 9, 37, 38]
    },
    "next": ["UD_ReturnHome"],
    "on_error": ["UD_ReturnHomeDone"]
  },
  "UD_ReturnHomeDone": {
    "next": ["UD_IsHomeAfterDirectory", "UD_ClickDirectoryTop", "UD_VerifyMenuDirectory"],
    "on_error": ["UD_DetectWhereAmI"]
  },
  "UD_ClickDirectoryTop": {
    "recognition": {
      "type": "OCR",
      "param": {
        "roi": [1183, 18, 87, 40],
        "expected": "目"
      }
    },
    "action": {
      "type": "Click",
      "param": {"target": true}
    },
    "post_wait_freezes": {
      "time": 500,
      "target": [1183, 18, 87, 40]
    },
    "next": ["UD_VerifyMenuDirectory", "UD_ReturnHomeDone"]
  },
  "UD_VerifyMenuDirectory": {
    "recognition": {
      "type": "OCR",
      "param": {
        "roi": [600, 34, 83, 49],
        "expected": "目录"
      }
    },
    "action": {
      "type": "Click",
      "param": {
        "target": [1037, 169, 110, 44]
      }
    },
    "post_wait_freezes": {
      "time": 500,
      "target": [1037, 169, 110, 44]
    },
    "next": ["UD_IsHomeAfterDirectory", "UD_ReturnHomeDone"]
  },
  "UD_IsHomeAfterDirectory": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "roi": [8, 1, 71, 107],
        "template": "Common/本丸.png",
        "green_mask": true,
        "threshold": [0.98]
      }
    },
    "next": ["UD_RunSwordBook"],
    "on_error": ["UD_ReturnHomeDone"]
  },
  "UD_RunSwordBook": {
    "action": {
      "type": "Custom",
      "custom_action": "UpdateDataPrepareAction",
      "custom_action_param": {"stage": "swordbook"}
    },
    "next": ["UD_SwordBookDetectWhereAmI"]
  },
  "UD_SwordBookDetectWhereAmI": {
    "timeout": 120000,
    "next": [
      "UD_SB_CheckHomeBrightness",
      "UD_SB_IsSwordBookList",
      "UD_SB_IsSwordBook",
      "UD_SB_IsSerial",
      "UD_SB_LeaveTroopRecord",
      "[JumpBack]IsAnnouncementPopup",
      "IsTeamStatusPanel",
      "[JumpBack]IsAdvertisementPopup",
      "[JumpBack]IsTrainingLetter",
      "[JumpBack]IsLoginReward",
      "[JumpBack]IsGameIcon",
      "[JumpBack]IsLoginButton",
      "[JumpBack]IsGameUpdatePopup",
      "[JumpBack]IsInGameUpdatePopup",
      "[JumpBack]IsInternalReport",
      "[JumpBack]IsTrainingApplication",
      "[JumpBack]IsNetworkRequestTimeout",
      "[JumpBack]IsConnectionInterrupted",
      "[JumpBack]FallbackWait"
    ],
    "on_error": ["UD_SB_RestartGame"]
  },
  "UD_SB_CheckHomeBrightness": {
    "recognition": {
      "type": "ColorMatch",
      "param": {
        "roi": [66, 58, 11, 13],
        "lower": [23, 95, 15],
        "upper": [40, 155, 30]
      }
    },
    "next": ["UD_SB_IsHome", "UD_SwordBookDetectWhereAmI"],
    "on_error": ["UD_SwordBookDetectWhereAmI"]
  },
  "UD_SB_IsHome": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "roi": [8, 1, 71, 107],
        "template": "Common/本丸.png",
        "green_mask": true,
        "threshold": [0.98]
      }
    },
    "next": ["UD_SB_ClickSwordPeople"],
    "on_error": ["UD_SwordBookDetectWhereAmI"]
  },
  "UD_SB_ClickSwordPeople": {
    "recognition": {
      "type": "OCR",
      "param": {
        "roi": [2, 163, 104, 28],
        "expected": "刀剑男士"
      }
    },
    "action": {
      "type": "Click",
      "param": {"target": true}
    },
    "next": ["UD_SwordBookDetectWhereAmI"],
    "on_error": ["UD_SwordBookDetectWhereAmI"]
  },
  "UD_SB_IsSwordBookList": {
    "recognition": {
      "type": "OCR",
      "param": {
        "roi": [534, 2, 220, 46],
        "expected": "刀剑男士一览"
      }
    },
    "action": {
      "type": "Click",
      "param": {
        "target": [10, 571, 26, 80]
      }
    },
    "next": ["UD_SwordBookDetectWhereAmI"],
    "on_error": ["UD_SwordBookDetectWhereAmI"]
  },
  "UD_SB_IsSwordBook": {
    "recognition": {
      "type": "OCR",
      "param": {
        "roi": [600, 7, 91, 42],
        "expected": "刀帐"
      }
    },
    "next": ["UD_SB_SwordBookColor", "UD_SB_ClickBookArrow"],
    "on_error": ["UD_SwordBookDetectWhereAmI"]
  },
  "UD_SB_SwordBookColor": {
    "recognition": {
      "type": "ColorMatch",
      "param": {
        "roi": [140, 98, 4, 5],
        "lower": [178, 33, 32],
        "upper": [178, 33, 32]
      }
    },
    "next": ["UD_SB_ClickSwordBook"],
    "on_error": ["UD_SwordBookDetectWhereAmI"]
  },
  "UD_SB_ClickSwordBook": {
    "action": {
      "type": "Click",
      "param": {
        "target": [154, 161, 106, 206]
      }
    },
    "next": ["UD_SwordBookDetectWhereAmI"],
    "on_error": ["UD_SwordBookDetectWhereAmI"]
  },
  "UD_SB_ClickBookArrow": {
    "action": {
      "type": "Click",
      "param": {
        "target": [140, 98, 4, 5]
      }
    },
    "post_wait_freezes": {
      "time": 300,
      "target": [140, 98, 4, 5]
    },
    "next": ["UD_SwordBookDetectWhereAmI"],
    "on_error": ["UD_SwordBookDetectWhereAmI"]
  },
  "UD_SB_IsSerial": {
    "recognition": {
      "type": "OCR",
      "param": {
        "roi": [527, 3, 229, 43],
        "expected": "序号"
      }
    },
    "action": {
      "type": "Custom",
      "custom_action": "SwordBookScanAction"
    },
    "next": ["UD_SaveSwordBook"],
    "on_error": ["UD_SwordBookDetectWhereAmI"]
  },
  "UD_SaveSwordBook": {
    "action": {
      "type": "Custom",
      "custom_action": "UpdateDataSaveAction",
      "custom_action_param": {"stage": "swordbook"}
    },
    "next": ["UD_CloseSwordBook"],
    "on_error": []
  },
  "UD_CloseSwordBook": {
    "action": {
      "type": "Click",
      "param": {
        "target": [134, 5, 36, 38]
      }
    },
    "post_wait_freezes": {
      "time": 300,
      "target": [134, 5, 36, 38]
    },
    "next": ["UD_CloseSwordBook2"]
  },
  "UD_CloseSwordBook2": {
    "action": {
      "type": "Click",
      "param": {
        "target": [134, 5, 36, 38]
      }
    },
    "next": ["UD_MarkSuccess"]
  },
  "UD_MarkSuccess": {
    "action": {
      "type": "Custom",
      "custom_action": "UpdateDataMarkSuccessAction"
    },
    "next": [],
    "on_error": []
  },
  "UD_SB_LeaveTroopRecord": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "roi": [577, 8, 130, 35],
        "template": "Common/部队记录页面.png",
        "green_mask": true,
        "threshold": [0.95]
      }
    },
    "action": {
      "type": "Click",
      "param": {
        "target": [63, 28, 17, 17]
      }
    },
    "next": ["UD_SwordBookDetectWhereAmI"],
    "on_error": ["UD_SwordBookDetectWhereAmI"]
  },
  "UD_RestartGame": {
    "action": {
      "type": "Custom",
      "custom_action": "RestartGameAction"
    },
    "next": ["UD_DetectWhereAmI"],
    "on_error": []
  },
  "UD_SB_RestartGame": {
    "action": {
      "type": "Custom",
      "custom_action": "RestartGameAction"
    },
    "next": ["UD_SwordBookDetectWhereAmI"],
    "on_error": []
  }
}
