{
  "WakeHome": {
    "next": ["WH_RestartGame"],
    "on_error": ["WH_RestartGame"]
  },
  "WH_RestartGame": {
    "action": {
      "type": "Custom",
      "custom_action": "RestartGameAction",
      "custom_action_param": {"log_auto_recovery": false}
    },
    "next": ["WH_MainHub"],
    "on_error": ["WH_RestartGame"]
  },
  "WH_MainHub": {
    "timeout": 120000,
    "next": [
      "[JumpBack]IsExpeditionReturn_Exp",
      "[JumpBack]WH_IsSwordDrop",
      "[JumpBack]IsAnnouncementPopup",
      "[JumpBack]IsTrainingLetter",
      "[JumpBack]IsLoginReward",
      "[JumpBack]IsInternalReport",
      "[JumpBack]IsAdvertisementPopup",
      "[JumpBack]IsGameIcon",
      "[JumpBack]IsLoginButton",
      "[JumpBack]IsGameUpdatePopup",
      "[JumpBack]IsInGameUpdatePopup",
      "[JumpBack]IsNetworkRequestTimeout",
      "[JumpBack]IsConnectionInterrupted",
      "[JumpBack]IsTrainingApplication",
      "[JumpBack]WH_OpenMenu",
      "WH_IsInMenu"
    ],
    "on_error": ["WH_RestartGame"]
  },
  "WH_IsSwordDrop": {
    "recognition": {
      "type": "ColorMatch",
      "param": {
        "roi": [598, 543, 66, 1],
        "lower": [88, 48, 2],
        "upper": [96, 56, 10]
      }
    },
    "action": {
      "type": "Click",
      "param": {
        "target": [1067, 558, 120, 79]
      }
    }
  },
  "WH_OpenMenu": {
    "recognition": {
      "type": "OCR",
      "param": {
        "roi": [1186, 19, 38, 36],
        "expected": "目"
      }
    },
    "action": {"type": "Click"},
    "post_wait_freezes": {
      "time": 200,
      "target": [1186, 19, 38, 36]
    }
  },
  "WH_IsInMenu": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "roi": [581, 28, 112, 57],
        "template": "Common/菜单目录.png",
        "green_mask": true,
        "threshold": [0.98]
      }
    },
    "action": {
      "type": "Click",
      "param": {
        "target": [1037, 169, 110, 44]
      }
    },
    "post_wait_freezes": {
      "time": 200,
      "target": [1037, 169, 110, 44]
    },
    "next": ["WH_CheckHomeBrightness"],
    "on_error": ["WH_MainHub"]
  },
  "WH_CheckHomeBrightness": {
    "recognition": {
      "type": "ColorMatch",
      "param": {
        "roi": [66, 58, 11, 13],
        "lower": [23, 95, 15],
        "upper": [40, 155, 30]
      }
    },
    "next": ["WH_CheckIsHome", "WH_MainHub"]
  },
  "WH_CheckIsHome": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "roi": [8, 1, 71, 107],
        "template": "Common/本丸.png",
        "green_mask": true,
        "threshold": [0.98]
      }
    },
    "on_error": ["WH_MainHub"]
  }
}
