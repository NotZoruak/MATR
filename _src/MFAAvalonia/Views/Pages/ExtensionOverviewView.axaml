<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MFAAvalonia.Views.Pages.ExtensionOverviewView">
    <UserControl.Styles>
        <Style Selector="Border.overview-section">
            <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="RadioButton.extension-navigation">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="NavigationBackground" Background="Transparent" CornerRadius="6" MinHeight="42">
                        <Grid ColumnDefinitions="3,*">
                            <Border Name="SelectionIndicator" Background="Transparent" CornerRadius="2"
                                    Height="22" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" Margin="12,8" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.extension-navigation:pointerover /template/ Border#NavigationBackground">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor5}" />
        </Style>
        <Style Selector="RadioButton.extension-navigation:checked">
            <Setter Property="Foreground" Value="{DynamicResource SukiPrimaryColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="RadioButton.extension-navigation:checked /template/ Border#NavigationBackground">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor15}" />
        </Style>
        <Style Selector="RadioButton.extension-navigation:checked /template/ Border#SelectionIndicator">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
        </Style>
        <Style Selector="RadioButton.extension-navigation:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="174,*" ColumnSpacing="16" Margin="0,16,0,0">
        <Border Classes="overview-section" Padding="12">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="8">
                        <Button Content="同步数据" HorizontalAlignment="Stretch" IsEnabled="False"
                                ToolTip.Tip="游戏数据读取服务尚未接入" />
                        <TextBlock Text="最后同步时间" Classes="caption" />
                        <TextBlock Text="尚未同步" FontSize="14" />
                        <TextBlock Text="数据读取服务尚未接入" Classes="caption" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <RadioButton Classes="extension-navigation" Content="数据总览" IsChecked="True" GroupName="ExtensionNavigation" />
                        <RadioButton Classes="extension-navigation" Content="部队状况" IsEnabled="False" ToolTip.Tip="后续开放" />
                        <RadioButton Classes="extension-navigation" Content="所持刀剑" IsEnabled="False" ToolTip.Tip="后续开放" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="数据总览" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="显示最近一次读取到的游戏状态" Classes="caption" />
                </StackPanel>
                <Border Classes="overview-section">
                    <StackPanel Spacing="12">
                        <TextBlock Text="账号资料" Classes="section-title" />
                        <TextBlock Text="暂无账号数据" FontSize="16" />
                        <TextBlock Text="连接游戏并完成首次同步后，显示本丸名称、审神者等级与近侍。" Classes="caption" />
                    </StackPanel>
                </Border>
                <Border Classes="overview-section">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="资源摘要" Classes="section-title" />
                                <TextBlock Text="仓库尚未同步" Classes="caption" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="同步到仓库" IsEnabled="False"
                                    ToolTip.Tip="取得游戏资源数据后可同步到仓库" />
                        </Grid>
                        <WrapPanel ItemWidth="140" ItemHeight="76">
                            <StackPanel Spacing="6" Margin="0,0,12,12">
                                <TextBlock Text="木炭" Classes="caption" />
                                <TextBlock Text="暂无数据" FontSize="16" />
                            </StackPanel>
                            <StackPanel Spacing="6" Margin="0,0,12,12">
                                <TextBlock Text="玉钢" Classes="caption" />
                                <TextBlock Text="暂无数据" FontSize="16" />
                            </StackPanel>
                            <StackPanel Spacing="6" Margin="0,0,12,12">
                                <TextBlock Text="冷却材" Classes="caption" />
                                <TextBlock Text="暂无数据" FontSize="16" />
                            </StackPanel>
                            <StackPanel Spacing="6" Margin="0,0,12,12">
                                <TextBlock Text="砥石" Classes="caption" />
                                <TextBlock Text="暂无数据" FontSize="16" />
                            </StackPanel>
                            <StackPanel Spacing="6" Margin="0,0,12,12">
                                <TextBlock Text="小判" Classes="caption" />
                                <TextBlock Text="暂无数据" FontSize="16" />
                            </StackPanel>
                            <StackPanel Spacing="6" Margin="0,0,12,12">
                                <TextBlock Text="委托符" Classes="caption" />
                                <TextBlock Text="暂无数据" FontSize="16" />
                            </StackPanel>
                            <StackPanel Spacing="6" Margin="0,0,12,12">
                                <TextBlock Text="加速符" Classes="caption" />
                                <TextBlock Text="暂无数据" FontSize="16" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="游戏数据早于仓库最新记录时，将拒绝同步并显示非阻塞提醒。" Classes="caption" />
                    </StackPanel>
                </Border>
                <Border Classes="overview-section">
                    <StackPanel Spacing="12">
                        <TextBlock Text="部队摘要" Classes="section-title" />
                        <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                            <TextBlock Text="部队1" />
                            <TextBlock Grid.Column="1" Text="暂无状态数据" Classes="caption" />
                        </Grid>
                        <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                            <TextBlock Text="部队2" />
                            <TextBlock Grid.Column="1" Text="暂无状态数据" Classes="caption" />
                        </Grid>
                        <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                            <TextBlock Text="部队3" />
                            <TextBlock Grid.Column="1" Text="暂无状态数据" Classes="caption" />
                        </Grid>
                        <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                            <TextBlock Text="部队4" />
                            <TextBlock Grid.Column="1" Text="暂无状态数据" Classes="caption" />
                        </Grid>
                        <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                            <TextBlock Text="部队5" />
                            <TextBlock Grid.Column="1" Text="暂无状态数据" Classes="caption" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Classes="overview-section">
                    <StackPanel Spacing="14">
                        <TextBlock Text="内番与工房" Classes="section-title" />
                        <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                            <TextBlock Text="内番" />
                            <TextBlock Grid.Column="1" Text="暂无数据，尚不能确认进行情况" Classes="caption" />
                        </Grid>
                        <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                            <TextBlock Text="锻刀" />
                            <TextBlock Grid.Column="1" Text="暂无数据，尚不能确认进行情况" Classes="caption" />
                        </Grid>
                        <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                            <TextBlock Text="修刀" />
                            <TextBlock Grid.Column="1" Text="暂无数据，尚不能确认进行情况" Classes="caption" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
