<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:MFAAvalonia.ViewModels.Pages"
             xmlns:services="clr-namespace:MFAAvalonia.Services"
             xmlns:extensions="clr-namespace:MFAAvalonia.Extensions"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="720"
             x:DataType="pages:WarehouseViewModel"
             x:Class="MFAAvalonia.Views.Pages.WarehouseView">
    <Design.DataContext>
        <pages:WarehouseViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding AutoRecognizeCommand}" IsEnabled="{Binding IsIdle}"
                        Background="#D9E6FF" Foreground="#165DFF">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="自动识别" />
                    <ProgressBar Width="22" Height="4" IsIndeterminate="True" IsVisible="{Binding IsRecognizing}" VerticalAlignment="Center" />
                </StackPanel>
                </Button>
                <Button Content="保存" Command="{Binding SaveCommand}" IsEnabled="{Binding HasUnsavedChanges}" Background="#5BAE7D" Foreground="White" />
                <Button Content="撤销" Command="{Binding RevertCommand}" IsEnabled="{Binding HasUnsavedChanges}" Background="#8A94A6" Foreground="White" />
                <Button Content="清空" Command="{Binding ClearCommand}" IsEnabled="{Binding IsIdle}" Background="#C96B6B" Foreground="White" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding AutoRecognizeHint}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SukiCardBackground}" CornerRadius="10" Padding="12,8">
            <StackPanel Spacing="6">
                <ItemsControl ItemsSource="{Binding CoreIconResources}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" HorizontalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pages:WarehouseCoreResourceViewModel">
                            <Border Background="#F4F5F7" BorderBrush="#D8DCE2" BorderThickness="1" CornerRadius="5" Padding="4,3" Margin="0,0,6,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" />
                                    <NumericUpDown Value="{Binding Count, Mode=TwoWay}" Minimum="0" Maximum="{Binding Maximum}"
                                                   Grid.Column="1" Height="28" FormatString="#,##0" ShowButtonSpinner="False"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding CoreTextResources}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" HorizontalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pages:WarehouseCoreResourceViewModel">
                            <Border Background="#F4F5F7" BorderBrush="#D8DCE2" BorderThickness="1" CornerRadius="5" Padding="4,3" Margin="0,0,6,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <NumericUpDown Value="{Binding Count, Mode=TwoWay}" Minimum="0" Maximum="{Binding Maximum}"
                                                   Grid.Column="1" Height="28" FormatString="#,##0" ShowButtonSpinner="False"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid x:Name="OtherResourcesLayout" Grid.Row="2" ColumnDefinitions="0.75*,1.5*" ColumnSpacing="12">
            <Border x:Name="OtherResourcesPanel" Grid.Column="0" Background="{DynamicResource SukiCardBackground}" CornerRadius="10" Padding="14,12">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="OtherResourcesTitle" Text="其他资源" FontSize="15" FontWeight="SemiBold" Foreground="#7B8798" VerticalAlignment="Center" />
                        <Button x:Name="OtherResourcesToggleButton" Grid.Column="1" Content="◀"
                                Click="OtherResourcesToggleButton_OnClick"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                Foreground="#7B8798" Padding="4,2" ToolTip.Tip="收起其他资源" />
                    </Grid>
                    <ScrollViewer x:Name="OtherItemsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="暂无已记录物品" Foreground="{DynamicResource SukiLowText}" HorizontalAlignment="Center" Margin="0,18,0,12"
                                       IsVisible="{Binding NoOtherItems}" />
                            <ItemsControl x:Name="OtherItemsList" ItemsSource="{Binding OtherItems}" IsVisible="{Binding HasOtherItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:WarehouseOtherItemViewModel">
                                        <Grid ColumnDefinitions="24,*,80" Margin="0,0,0,8" ColumnSpacing="6"
                                              IsVisible="{Binding IsVisible}">
                                            <TextBlock Text="⋮⋮" FontSize="16" Foreground="#9AA4B2"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Cursor="Hand"
                                                       PointerPressed="OtherItemDragHandle_OnPointerPressed"
                                                       PointerMoved="OtherItemDragHandle_OnPointerMoved"
                                                       PointerReleased="OtherItemDragHandle_OnPointerReleased" />
                                            <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" />
                                            <TextBox Grid.Column="2" Text="{Binding Count, Mode=TwoWay}" HorizontalContentAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="＋ 添加物品" Command="{Binding AddOtherItemCommand}" HorizontalAlignment="Center"
                                    Margin="0,4,0,12" Padding="14,5" Background="Transparent" Foreground="#7B8798" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource SukiCardBackground}" CornerRadius="10" Padding="14,12">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
                        <Button Grid.Column="1" Content="{Binding Last24HoursButtonText}" Command="{Binding SelectLast24HoursCommand}"
                                Background="Transparent" Foreground="#7B8798" Padding="8,2" />
                        <Button Grid.Column="2" Content="{Binding Last7DaysButtonText}" Command="{Binding SelectLast7DaysCommand}"
                                Background="Transparent" Foreground="#7B8798" Padding="8,2" />
                        <Button Grid.Column="3" Content="{Binding Last30DaysButtonText}" Command="{Binding SelectLast30DaysCommand}"
                                Background="Transparent" Foreground="#7B8798" Padding="8,2" />
                        <Border Grid.Column="4" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6"
                                Margin="2,0" Padding="2,0" Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="−" Command="{Binding ZoomChartOutCommand}"
                                        IsEnabled="{Binding CanZoomChartOut}"
                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                        Foreground="#7B8798" Padding="4,2"
                                        ToolTip.Tip="缩小时间范围" />
                                <TextBlock Text="{Binding ChartZoomText}" MinWidth="48" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="#7B8798" />
                                <Button Content="+" Command="{Binding ZoomChartInCommand}"
                                        IsEnabled="{Binding CanZoomChartIn}"
                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                        Foreground="#7B8798" Padding="4,2"
                                        ToolTip.Tip="放大时间范围" />
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="5" Content="刷新图表" Command="{Binding RefreshChartsCommand}"
                                Background="Transparent" Foreground="#7B8798" Padding="8,2" />
                        <Button Grid.Column="6" Content="清空" Command="{Binding ClearChartHistoryCommand}"
                                Background="Transparent" Foreground="#C96B6B" Padding="8,2" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <TextBlock Text="暂无识别记录" Foreground="{DynamicResource SukiLowText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding NoChartHistory}" />
                            <Border Background="{DynamicResource SukiBackgroundColor}" CornerRadius="8" Padding="10"
                                    IsVisible="{Binding ComparisonChart.HasHistory}">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <TextBlock Text="核心资源趋势对比" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ComparisonResources}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="pages:WarehouseComparisonResourceOption">
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                              Command="{Binding ToggleCommand}" Foreground="#7B8798"
                                                              Padding="6,2" Margin="0,0,8,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Spacing="2" IsVisible="{Binding ComparisonChart.HasCompletedSelection}">
                                        <TextBlock Text="{Binding ComparisonChart.TimeSummaryText}" Foreground="#B5791F" />
                                        <ItemsControl ItemsSource="{Binding ComparisonChart.SelectionRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="pages:WarehouseComparisonSelectionRowViewModel">
                                                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding Name}" Foreground="#B5791F" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="#B5791F" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Grid x:Name="ComparisonChartViewport" Grid.Row="2" Height="{Binding ComparisonChart.ViewportHeight}"
                                          HorizontalAlignment="Stretch" ClipToBounds="True"
                                          SizeChanged="ComparisonChartViewport_OnSizeChanged">
                                        <Canvas Width="{Binding ComparisonChart.ViewportWidth}" Height="{Binding ComparisonChart.ViewportHeight}">
                                                    <Line StartPoint="{Binding ComparisonChart.HorizontalGridStartPoint45}" EndPoint="{Binding ComparisonChart.HorizontalGridEndPoint45}" Stroke="#AAB4C3" StrokeThickness="{Binding ComparisonChart.VisualScale}" StrokeDashArray="4,4" Opacity="0.55" />
                                                    <Line StartPoint="{Binding ComparisonChart.HorizontalGridStartPoint95}" EndPoint="{Binding ComparisonChart.HorizontalGridEndPoint95}" Stroke="#AAB4C3" StrokeThickness="{Binding ComparisonChart.VisualScale}" StrokeDashArray="4,4" Opacity="0.55" />
                                                    <Line StartPoint="{Binding ComparisonChart.HorizontalGridStartPoint150}" EndPoint="{Binding ComparisonChart.HorizontalGridEndPoint150}" Stroke="#AAB4C3" StrokeThickness="{Binding ComparisonChart.VisualScale}" StrokeDashArray="4,4" Opacity="0.55" />
                                                    <Line StartPoint="{Binding ComparisonChart.VerticalGridStartPoint162}" EndPoint="{Binding ComparisonChart.VerticalGridEndPoint162}" Stroke="#AAB4C3" StrokeThickness="{Binding ComparisonChart.VisualScale}" StrokeDashArray="4,4" Opacity="0.55" />
                                                    <Line StartPoint="{Binding ComparisonChart.VerticalGridStartPoint325}" EndPoint="{Binding ComparisonChart.VerticalGridEndPoint325}" Stroke="#AAB4C3" StrokeThickness="{Binding ComparisonChart.VisualScale}" StrokeDashArray="4,4" Opacity="0.55" />
                                                    <Line StartPoint="{Binding ComparisonChart.VerticalGridStartPoint487}" EndPoint="{Binding ComparisonChart.VerticalGridEndPoint487}" Stroke="#AAB4C3" StrokeThickness="{Binding ComparisonChart.VisualScale}" StrokeDashArray="4,4" Opacity="0.55" />
                                                    <Line StartPoint="{Binding ComparisonChart.BaselineStartPoint}" EndPoint="{Binding ComparisonChart.BaselineEndPoint}" Stroke="#7B8798" StrokeThickness="{Binding ComparisonChart.VisualScale}" />
                                                    <ItemsControl ItemsSource="{Binding ComparisonChart.Series}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas Width="{Binding ComparisonChart.ViewportWidth}" Height="{Binding ComparisonChart.ViewportHeight}" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="pages:WarehouseComparisonSeriesViewModel">
                                                                <Canvas Width="{Binding ViewportWidth}" Height="{Binding CanvasHeight}">
                                                                    <Path Data="{Binding LineGeometry}" Stroke="{Binding Color}" StrokeThickness="{Binding PathStrokeThickness}" Stretch="None" />
                                                                    <ItemsControl Width="{Binding ViewportWidth}" Height="{Binding CanvasHeight}" ItemsSource="{Binding Points}">
                                                                        <ItemsControl.Styles>
                                                                            <Style Selector="ContentPresenter">
                                                                                <Setter Property="Canvas.Left" Value="{ReflectionBinding Left}" />
                                                                                <Setter Property="Canvas.Top" Value="{ReflectionBinding Top}" />
                                                                                <Setter Property="Panel.ZIndex" Value="1" />
                                                                            </Style>
                                                                        </ItemsControl.Styles>
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate><Canvas Width="{Binding ViewportWidth}" Height="{Binding CanvasHeight}" /></ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="pages:WarehouseChartPointViewModel">
                                                                                <Ellipse Width="{Binding MarkerWidth}" Height="{Binding MarkerSize}" Fill="{Binding PointBrush}" Stroke="White" StrokeThickness="{Binding MarkerStrokeThickness}"
                                                                                         Opacity="{Binding MarkerOpacity}"
                                                                                         PointerPressed="ChartPoint_OnPointerPressed">
                                                                                    <ToolTip.Tip>
                                                                                        <ToolTip>
                                                                                            <Border Padding="12,8" CornerRadius="8" Background="#FFFFFF">
                                                                                                <StackPanel Spacing="2">
                                                                                                    <TextBlock Text="{Binding RecordedAtText}" Foreground="#202735" />
                                                                                                    <TextBlock Text="{Binding CurrentText}" Foreground="#202735" />
                                                                                                    <StackPanel Orientation="Horizontal">
                                                                                                        <TextBlock Text="变动：" Foreground="#202735" />
                                                                                                        <TextBlock Text="{Binding ChangeValueText}" Foreground="{Binding ChangeBrush}" />
                                                                                                    </StackPanel>
                                                                                                </StackPanel>
                                                                                            </Border>
                                                                                        </ToolTip>
                                                                                    </ToolTip.Tip>
                                                                                    <Ellipse.ContextMenu>
                                                                                        <ContextMenu>
                                                                                            <MenuItem Header="删除此记录点" Command="{Binding DeleteCommand}" />
                                                                                        </ContextMenu>
                                                                                    </Ellipse.ContextMenu>
                                                                                </Ellipse>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Canvas>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                        </Canvas>
                                        <ItemsControl Width="{Binding ComparisonChart.ViewportWidth}" Height="{Binding ComparisonChart.ViewportHeight}" HorizontalAlignment="Left"
                                                      ItemsSource="{Binding ComparisonChart.AxisLabels}">
                                            <ItemsControl.Styles>
                                                <Style Selector="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{ReflectionBinding X}" />
                                                    <Setter Property="Canvas.Top" Value="{ReflectionBinding Y}" />
                                                    <Setter Property="Panel.ZIndex" Value="2" />
                                                </Style>
                                            </ItemsControl.Styles>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas Width="{Binding ComparisonChart.ViewportWidth}" Height="{Binding ComparisonChart.ViewportHeight}" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="services:WarehouseChartTimeAxisLabel">
                                                    <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="#7B8798"
                                                               HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding ComparisonChart.LegendMargin}"
                                                RenderTransform="{Binding ComparisonChart.LegendTransform}" RenderTransformOrigin="0,0"
                                                Padding="8,5" CornerRadius="6"
                                                Background="#EEFFFFFF" BorderBrush="#D8DEE8" BorderThickness="1">
                                            <ItemsControl ItemsSource="{Binding ComparisonChart.Series}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="pages:WarehouseComparisonSeriesViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,0">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#202735" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Grid>
                                    <ScrollBar Grid.Row="3" Orientation="Horizontal" Height="14"
                                               Minimum="0" Maximum="{Binding ComparisonChart.ScrollMaximum}"
                                               ViewportSize="{Binding ComparisonChart.ScrollViewportSize}"
                                               SmallChange="1" LargeChange="{Binding ComparisonChart.ScrollViewportSize}"
                                               Value="{Binding ComparisonChart.ScrollValue, Mode=TwoWay}"
                                               IsVisible="{Binding ComparisonChart.HasScrollBar}" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Charts}" IsVisible="{Binding HasChartHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:WarehouseChartViewModel">
                                        <Border Background="{DynamicResource SukiBackgroundColor}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="110,*" ColumnSpacing="12" RowSpacing="4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SelectionSummaryText}" Foreground="#B5791F" TextWrapping="Wrap" IsVisible="{Binding HasCompletedSelection}" />
                                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Height="{Binding ViewportHeight}" ClipToBounds="True"
                                                      IsVisible="{Binding HasHistory}">
                                            <Canvas Width="{Binding ViewportWidth}" Height="{Binding ViewportHeight}">
                                                        <Line StartPoint="{Binding HorizontalGridStartPoint30}" EndPoint="{Binding HorizontalGridEndPoint30}" Stroke="#AAB4C3" StrokeThickness="{Binding VisualScale}" StrokeDashArray="4,4" Opacity="0.55" />
                                                        <Line StartPoint="{Binding HorizontalGridStartPoint68}" EndPoint="{Binding HorizontalGridEndPoint68}" Stroke="#AAB4C3" StrokeThickness="{Binding VisualScale}" StrokeDashArray="4,4" Opacity="0.55" />
                                                        <Line StartPoint="{Binding HorizontalGridStartPoint106}" EndPoint="{Binding HorizontalGridEndPoint106}" Stroke="#AAB4C3" StrokeThickness="{Binding VisualScale}" StrokeDashArray="4,4" Opacity="0.55" />
                                                        <Line StartPoint="{Binding VerticalGridStartPoint162}" EndPoint="{Binding VerticalGridEndPoint162}" Stroke="#AAB4C3" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.55" />
                                                        <Line StartPoint="{Binding VerticalGridStartPoint325}" EndPoint="{Binding VerticalGridEndPoint325}" Stroke="#AAB4C3" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.55" />
                                                        <Line StartPoint="{Binding VerticalGridStartPoint487}" EndPoint="{Binding VerticalGridEndPoint487}" Stroke="#AAB4C3" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.55" />
                                                        <Line StartPoint="{Binding BaselineStartPoint}" EndPoint="{Binding BaselineEndPoint}" Stroke="#7B8798" StrokeThickness="{Binding VisualScale}" />
                                                        <Path Data="{Binding LineGeometry}" Stroke="#5B8FF9" StrokeThickness="{Binding PathStrokeThickness}" Stretch="None" />
                                                        <ItemsControl Width="{Binding ViewportWidth}" Height="{Binding ViewportHeight}" ItemsSource="{Binding Points}">
                                                            <ItemsControl.Styles>
                                                                <Style Selector="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{ReflectionBinding Left}" />
                                                                    <Setter Property="Canvas.Top" Value="{ReflectionBinding Top}" />
                                                                    <Setter Property="Panel.ZIndex" Value="1" />
                                                                </Style>
                                                            </ItemsControl.Styles>
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="{Binding ViewportWidth}" Height="{Binding ViewportHeight}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="pages:WarehouseChartPointViewModel">
                                                                    <Ellipse Width="{Binding MarkerWidth}" Height="{Binding MarkerSize}" Fill="{Binding PointBrush}" Stroke="White" StrokeThickness="{Binding MarkerStrokeThickness}"
                                                                             Opacity="{Binding MarkerOpacity}" PointerPressed="ChartPoint_OnPointerPressed">
                                                                        <ToolTip.Tip><ToolTip><Border Padding="12,8" CornerRadius="8" Background="#FFFFFF"><StackPanel Spacing="2"><TextBlock Text="{Binding RecordedAtText}" Foreground="#202735" /><TextBlock Text="{Binding CurrentText}" Foreground="#202735" /><StackPanel Orientation="Horizontal"><TextBlock Text="变动：" Foreground="#202735" /><TextBlock Text="{Binding ChangeValueText}" Foreground="{Binding ChangeBrush}" /></StackPanel></StackPanel></Border></ToolTip></ToolTip.Tip>
                                                                        <Ellipse.ContextMenu><ContextMenu><MenuItem Header="删除此记录点" Command="{Binding DeleteCommand}" /></ContextMenu></Ellipse.ContextMenu>
                                                                    </Ellipse>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                            </Canvas>
                                                    <ItemsControl Width="{Binding ViewportWidth}" Height="{Binding ViewportHeight}" HorizontalAlignment="Left"
                                                                  ItemsSource="{Binding AxisLabels}">
                                                        <ItemsControl.Styles>
                                                            <Style Selector="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{ReflectionBinding X}" />
                                                                <Setter Property="Canvas.Top" Value="{ReflectionBinding Y}" />
                                                                <Setter Property="Panel.ZIndex" Value="2" />
                                                            </Style>
                                                        </ItemsControl.Styles>
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><Canvas Width="{Binding ViewportWidth}" Height="{Binding ViewportHeight}" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="services:WarehouseChartTimeAxisLabel">
                                                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="#7B8798"
                                                                           HorizontalAlignment="Center" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                                <ScrollBar Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Height="14"
                                                           Minimum="0" Maximum="{Binding ScrollMaximum}"
                                                           ViewportSize="{Binding ScrollViewportSize}"
                                                           SmallChange="1" LargeChange="{Binding ScrollViewportSize}"
                                                           Value="{Binding ScrollValue, Mode=TwoWay}"
                                                           IsVisible="{Binding HasScrollBar}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
