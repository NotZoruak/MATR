<UserControl
    d:DesignHeight="700"
    d:DesignWidth="900"
    mc:Ignorable="d"
    x:Class="MFAAvalonia.Views.Pages.SilhouetteView"
    x:DataType="pages:SilhouetteViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:MFAAvalonia.ViewModels.Pages"
    xmlns:models="clr-namespace:MFAAvalonia.Models"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent">

    <Design.DataContext>
        <pages:SilhouetteViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <Grid RowDefinitions="Auto,*" Margin="0">

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{Binding RecognizeCommand}"
                        Padding="24,10" Classes="Accent"
                        IsEnabled="{Binding !IsRecognizing}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <fluent:FluentIcon Icon="Camera" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock FontSize="14" VerticalAlignment="Center" Text="识别当前画面" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding StatusMessage}" FontSize="14"
                           Foreground="{DynamicResource SukiLowText}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="16" Margin="0,16,0,0">

                <!-- 左侧：识别结果 -->
                <Border Grid.Column="0" Background="{DynamicResource SukiCardBackground}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="识别结果" FontWeight="Bold" FontSize="16" />
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RecognitionResult">
                                    <Border Padding="8,6" Margin="0,2" CornerRadius="4"
                                            Background="{DynamicResource SukiCardBackground}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                                       FontSize="18" FontWeight="Bold"
                                                       VerticalAlignment="Center" Width="30" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" />
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource SukiLowText}"
                                                           Text="{Binding TypeLabel}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ScoreText}"
                                                       FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Width="60" TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 右侧：模板预览 -->
                <Border Grid.Column="1" Background="{DynamicResource SukiCardBackground}"
                        CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="模板预览" FontWeight="Bold" FontSize="15" />
                        <!-- 已识别时显示模板图 -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                              IsVisible="{Binding !!Preview1}">
                            <Border Grid.Column="0" CornerRadius="6"
                                    Background="{DynamicResource SukiLowBackground}" Padding="6">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource SystemAccentColor}"
                                               Text="{Binding Results[0].Name}" />
                                    <Image Source="{Binding Preview1}"
                                           MaxWidth="280" MaxHeight="280" Stretch="Uniform" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="6"
                                    Background="{DynamicResource SukiLowBackground}" Padding="6"
                                    IsVisible="{Binding !!Preview2}">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="11" Text="{Binding Results[1].Name}" />
                                    <Image Source="{Binding Preview2}"
                                           MaxWidth="280" MaxHeight="280" Stretch="Uniform" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <!-- 未识别时显示提示 -->
                        <TextBlock Text="点击「识别当前画面」开始"
                                   FontSize="13" Foreground="{DynamicResource SukiLowText}"
                                   IsVisible="{Binding !Preview1}" />
                    </StackPanel>
                </Border>

            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
