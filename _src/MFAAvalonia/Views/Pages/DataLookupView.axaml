<UserControl
    d:DesignHeight="700"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="MFAAvalonia.Views.Pages.DataLookupView"
    x:DataType="pages:DataLookupViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:MFAAvalonia.ViewModels.Pages"
    xmlns:suki="using:SukiUI.Extensions"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent">

    <Design.DataContext>
        <pages:DataLookupViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <Grid Margin="16,12">
            <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                        suki:TabControlExtensions.HeaderHorizontalAlignment="Center">
                <TabControl.Styles>
                    <Style Selector="TabItem.data-lookup-tab /template/ ContentPresenter#PART_HeaderPresenter">
                        <Setter Property="TextBlock.FontSize" Value="20" />
                    </Style>
                </TabControl.Styles>

                <!-- ========== 经验表（极） ========== -->
                <TabItem Classes="data-lookup-tab">
                    <TabItem.Header>
                        <TextBlock Text="经验表（极）" FontSize="20" />
                    </TabItem.Header>
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                        <!-- 计算区 -->
                        <Border Grid.Row="0" Background="{DynamicResource SukiCardBackground}"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="刀种:" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{x:Static pages:SwordExpCurves.SwordTypes}"
                                              SelectedIndex="{Binding SelectedSwordTypeIndex}"
                                              MinWidth="108" />
                                    <TextBlock Text="当前经验:" VerticalAlignment="Center" />
                                    <NumericUpDown Value="{Binding CurrentExp}" Minimum="0" Maximum="999999999"
                                                   Increment="1000" MinWidth="150" />
                                    <TextBlock Text="目标等级:" VerticalAlignment="Center" />
                                    <NumericUpDown Value="{Binding TargetLevel}" Minimum="1" Maximum="100"
                                                   MinWidth="108" />
                                    <Button Content="计算" Command="{Binding CalculateExpCommand}"
                                            Classes="Accent" MinWidth="98" />
                                </StackPanel>
                                <TextBlock Text="{Binding ResultText}" FontWeight="Bold"
                                           IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Text="完整经验表（参考）" FontSize="12"
                                   Opacity="0.5" Margin="4,0,0,0" />

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding ExpTableItems}"
                                  IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Styles>
                                <Style Selector="DataGridCell">
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="Padding" Value="6,2" />
                                </Style>
                            </DataGrid.Styles>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="等级" Binding="{Binding Level}" Width="1*"
                                                    FontSize="14" />
                                <DataGridTextColumn Header="累计经验" Binding="{Binding CumulativeExp}" Width="2*"
                                                    FontSize="14" />
                                <DataGridTextColumn Header="升级所需" Binding="{Binding RequiredExp}" Width="2*"
                                                    FontSize="14" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ========== 远征收益 ========== -->
                <TabItem Classes="data-lookup-tab">
                    <TabItem.Header>
                        <TextBlock Text="远征收益" FontSize="20" />
                    </TabItem.Header>
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Grid.Row="0" Text="{Binding ExpeditionEfficiencyNote}"
                                   FontSize="12" Opacity="0.5" Margin="4,0,0,0" />

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ExpeditionRewardDisplayItems}"
                                  SelectedItem="{Binding SelectedExpeditionItem}"
                                  SelectionMode="Single"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  RowHeight="60"
                                 >
                            <DataGrid.Styles>
                                <Style Selector="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                                <Style Selector="DataGridColumnHeader ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                                <Style Selector="DataGridRow:selected">
                                    <Setter Property="BorderBrush" Value="#FF8C1E" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </Style>
                                <Style Selector="DataGridRow:selected /template/ Border#RowBorder">
                                    <Setter Property="BorderBrush" Value="#FF8C1E" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </Style>
                            </DataGrid.Styles>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="82">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="远征" TextAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="4,3" CornerRadius="4">
                                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"
                                                           />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="105">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock HorizontalAlignment="Stretch" Text="时间" TextAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="4,3" CornerRadius="4">
                                                <TextBlock Text="{Binding Duration}" HorizontalAlignment="Center"
                                                           />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="98">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock HorizontalAlignment="Stretch" Text="木炭" TextAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Stretch" Background="{Binding CharcoalBg}" Padding="4,3" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CharcoalValue}" HorizontalAlignment="Center"
                                                               />
                                                    <TextBlock Text="{Binding CharcoalEff}" FontSize="12"
                                                               Foreground="Gray" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="98">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock HorizontalAlignment="Stretch" Text="玉钢" TextAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Stretch" Background="{Binding SteelBg}" Padding="4,3" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SteelValue}" HorizontalAlignment="Center"
                                                               />
                                                    <TextBlock Text="{Binding SteelEff}" FontSize="12"
                                                               Foreground="Gray" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="98">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock HorizontalAlignment="Stretch" Text="冷却材" TextAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Stretch" Background="{Binding CoolantBg}" Padding="4,3" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CoolantValue}" HorizontalAlignment="Center"
                                                               />
                                                    <TextBlock Text="{Binding CoolantEff}" FontSize="12"
                                                               Foreground="Gray" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="98">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock HorizontalAlignment="Stretch" Text="砥石" TextAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Stretch" Background="{Binding WhetstoneBg}" Padding="4,3" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding WhetstoneValue}" HorizontalAlignment="Center"
                                                               />
                                                    <TextBlock Text="{Binding WhetstoneEff}" FontSize="12"
                                                               Foreground="Gray" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="108">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock HorizontalAlignment="Stretch" Text="总资源" TextAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Stretch" Background="{Binding TotalBg}" Padding="4,3" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TotalValue}" HorizontalAlignment="Center"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding TotalEff}" FontSize="12"
                                                               Foreground="Gray" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="105">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock HorizontalAlignment="Stretch" Text="小判" TextAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Stretch" Background="{Binding GoldBg}" Padding="4,3" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding GoldValue}" HorizontalAlignment="Center"
                                                               />
                                                    <TextBlock Text="{Binding GoldEff}" FontSize="12"
                                                               Foreground="Gray" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="105">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock HorizontalAlignment="Stretch" Text="加速符" TextAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Stretch" Background="{Binding SpeedBg}" Padding="4,3" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SpeedValue}" HorizontalAlignment="Center"
                                                               />
                                                    <TextBlock Text="{Binding SpeedEff}" FontSize="12"
                                                               Foreground="Gray" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="105">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock HorizontalAlignment="Stretch" Text="委托符" TextAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Stretch" Background="{Binding TicketBg}" Padding="4,3" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TicketValue}" HorizontalAlignment="Center"
                                                               />
                                                    <TextBlock Text="{Binding TicketEff}" FontSize="12"
                                                               Foreground="Gray" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>
