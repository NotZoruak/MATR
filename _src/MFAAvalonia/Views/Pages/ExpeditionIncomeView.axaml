<UserControl
    d:DesignHeight="700"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="MFAAvalonia.Views.Pages.ExpeditionIncomeView"
    x:DataType="pages:DataLookupViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:MFAAvalonia.ViewModels.Pages"
    xmlns:suki="using:SukiUI.Extensions"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent">

    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="{Binding ExpeditionEfficiencyNote}"
                   FontSize="12" Opacity="0.5" Margin="4,0,0,0" />

        <DataGrid x:Name="ExpeditionGrid" Grid.Row="1"
                  ItemsSource="{Binding ExpeditionRewardDisplayItems}"
                  SelectedItem="{Binding SelectedExpeditionItem}"
                  SelectionMode="Single"
                  IsReadOnly="True" AutoGenerateColumns="False"
                  RowHeight="52"
                  GridLinesVisibility="All"
                  HorizontalScrollBarVisibility="Visible"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Styles>
                <!-- 滚动条固定在表格可视区域底部，不随鼠标离开而隐藏。 -->
                <Style Selector="DataGrid /template/ ScrollBar#PART_HorizontalScrollbar">
                    <Setter Property="AllowAutoHide" Value="False" />
                </Style>
                <Style Selector="DataGrid#ExpeditionGrid[IsReadOnly=True] DataGridRow /template/ DataGridCellsPresenter#PART_CellsPresenter">
                    <Setter Property="Margin" Value="0" />
                </Style>
                <Style Selector="DataGrid#ExpeditionGrid DataGridCell TextBlock">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="TextAlignment" Value="Center" />
                </Style>
                <Style Selector="DataGrid#ExpeditionGrid DataGridColumnHeader">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Name="PART_Border" Background="Transparent" Padding="0,7"
                                    BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="0,0,1,1.5">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                      VerticalAlignment="Center" />
                                    <Path Name="SortIcon" Width="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Stretch="Uniform" Fill="{DynamicResource SukiText}" Data="M -5,6 L 5,6 L 0,0 Z" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="DataGridRow:selected">
                    <Setter Property="BorderBrush" Value="#FF8C1E" />
                    <Setter Property="BorderThickness" Value="2" />
                </Style>
                <Style Selector="DataGridRow:selected /template/ Border#RowBorder">
                    <Setter Property="BorderBrush" Value="#FF8C1E" />
                    <Setter Property="BorderThickness" Value="2" />
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="64">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="远征" TextAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="1,2" CornerRadius="4">
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"
                                           />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="72">
                    <DataGridTemplateColumn.Header>
                        <TextBlock HorizontalAlignment="Stretch" Text="时间" TextAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="1,2" CornerRadius="4">
                                <TextBlock Text="{Binding Duration}" HorizontalAlignment="Center"
                                           />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.Header>
                        <TextBlock HorizontalAlignment="Stretch" Text="木炭" TextAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Stretch" Background="{Binding CharcoalBg}" Padding="1,2" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding CharcoalValue}" HorizontalAlignment="Center"
                                               />
                                    <TextBlock Text="{Binding CharcoalEff}" FontSize="12"
                                               Foreground="Gray" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.Header>
                        <TextBlock HorizontalAlignment="Stretch" Text="玉钢" TextAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Stretch" Background="{Binding SteelBg}" Padding="1,2" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding SteelValue}" HorizontalAlignment="Center"
                                               />
                                    <TextBlock Text="{Binding SteelEff}" FontSize="12"
                                               Foreground="Gray" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.Header>
                        <TextBlock HorizontalAlignment="Stretch" Text="冷却材" TextAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Stretch" Background="{Binding CoolantBg}" Padding="1,2" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding CoolantValue}" HorizontalAlignment="Center"
                                               />
                                    <TextBlock Text="{Binding CoolantEff}" FontSize="12"
                                               Foreground="Gray" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.Header>
                        <TextBlock HorizontalAlignment="Stretch" Text="砥石" TextAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Stretch" Background="{Binding WhetstoneBg}" Padding="1,2" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding WhetstoneValue}" HorizontalAlignment="Center"
                                               />
                                    <TextBlock Text="{Binding WhetstoneEff}" FontSize="12"
                                               Foreground="Gray" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.Header>
                        <TextBlock HorizontalAlignment="Stretch" Text="总资源" TextAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Stretch" Background="{Binding TotalBg}" Padding="1,2" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalValue}" HorizontalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TotalEff}" FontSize="12"
                                               Foreground="Gray" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.Header>
                        <TextBlock HorizontalAlignment="Stretch" Text="小判" TextAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Stretch" Background="{Binding GoldBg}" Padding="1,2" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding GoldValue}" HorizontalAlignment="Center"
                                               />
                                    <TextBlock Text="{Binding GoldEff}" FontSize="12"
                                               Foreground="Gray" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.Header>
                        <TextBlock HorizontalAlignment="Stretch" Text="加速符" TextAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Stretch" Background="{Binding SpeedBg}" Padding="1,2" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding SpeedValue}" HorizontalAlignment="Center"
                                               />
                                    <TextBlock Text="{Binding SpeedEff}" FontSize="12"
                                               Foreground="Gray" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.Header>
                        <TextBlock HorizontalAlignment="Stretch" Text="委托符" TextAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Stretch" Background="{Binding TicketBg}" Padding="1,2" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding TicketValue}" HorizontalAlignment="Center"
                                               />
                                    <TextBlock Text="{Binding TicketEff}" FontSize="12"
                                               Foreground="Gray" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
