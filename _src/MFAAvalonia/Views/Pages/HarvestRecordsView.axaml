<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MFAAvalonia.Views.Pages.HarvestRecordsView">
  <UserControl.Styles>
    <Style Selector=":is(Control).harvest-filter">
      <Setter Property="Height" Value="38" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.harvest-filter">
      <Setter Property="Width" Value="100" />
    </Style>
    <Style Selector="ComboBox#HarvestKindPicker">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="{DynamicResource DefaultDemiBold}" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiControlBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SukiBackground}" />
    </Style>
    <Style Selector="DataGrid#RecordsGrid[GridLinesVisibility=All] DataGridRow /template/ DataGridCellsPresenter#PART_CellsPresenter">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="DataGrid#RecordsGrid DataGridColumnHeader">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" Padding="0,7" BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="0,0,0,1.5">
            <Grid HorizontalAlignment="Stretch">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" />
              <Border Width="1" Margin="0,-7,0,-7" HorizontalAlignment="Right" Background="{DynamicResource SukiBorderBrush}" IsHitTestVisible="False" />
              <Path Name="SortIcon" Width="8" Margin="0,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="Uniform" Fill="{DynamicResource SukiText}" Data="M -5,6 L 5,6 L 0,0 Z" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Path#SortIcon"><Setter Property="IsVisible" Value="False" /></Style>
      <Style Selector="^:sortascending /template/ Path#SortIcon"><Setter Property="IsVisible" Value="True" /></Style>
      <Style Selector="^:sortdescending /template/ Path#SortIcon"><Setter Property="IsVisible" Value="True" /></Style>
    </Style>
    <Style Selector="DataGrid#RecordsGrid DataGridCell TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="DataGrid#RecordsGrid DataGridColumnHeader TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="DataGrid#RecordsGrid DataGridCell TextBlock">
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource SukiCardBackground}" CornerRadius="12" Padding="16" Margin="0,0,8,0">
    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,100" RowSpacing="10" ColumnSpacing="8">
      <Grid ColumnDefinitions="100,*" ColumnSpacing="8">
        <ComboBox x:Name="HarvestKindPicker" Classes="harvest-filter" Padding="6,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <ComboBoxItem Content="刀剑" />
          <ComboBoxItem Content="物品" />
          <ComboBoxItem Content="内番" />
        </ComboBox>
        <TextBox x:Name="SearchBox" Classes="harvest-filter" VerticalContentAlignment="Center" Grid.Column="1" MinWidth="0" Watermark="搜索名称、来源、地图或点位" TextChanged="SearchChanged">
          <ToolTip.Tip>
            <Border Background="{DynamicResource SukiCardBackground}" BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" MaxWidth="360">
              <StackPanel Spacing="6">
                <TextBlock Text="组合筛选" FontWeight="SemiBold" />
                <TextBlock Text="+词：必须包含；-词：排除；不带符号的词也表示必须包含。" TextWrapping="Wrap" />
                <TextBlock Text="多个条件用空格分开，所有条件同时生效。" TextWrapping="Wrap" />
                <TextBlock Text="示例：+活动 -远征 三日月" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </ToolTip.Tip>
        </TextBox>
      </Grid>
      <Button x:Name="ClearButton" Classes="harvest-filter" Grid.Column="1" Content="清除数据" Click="ClearClicked" />
      <Grid x:Name="DateFilterGrid" Grid.Row="1" Column="0" ColumnDefinitions="Auto,Auto,*,Auto,*" ColumnSpacing="8">
        <Button x:Name="AllTimeButton" Classes="harvest-filter" Content="全部时间" Click="ClearDateFilter" />
        <TextBlock Grid.Column="1" Text="时间范围" VerticalAlignment="Center" />
        <CalendarDatePicker Grid.Column="2" x:Name="StartDatePicker" Classes="harvest-filter" Watermark="开始日期" SelectedDateChanged="DateFilterChanged" MinWidth="0" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Column="3" Text="至" VerticalAlignment="Center" />
        <CalendarDatePicker Grid.Column="4" x:Name="EndDatePicker" Classes="harvest-filter" Watermark="结束日期" SelectedDateChanged="DateFilterChanged" MinWidth="0" HorizontalAlignment="Stretch" />
      </Grid>
      <Button x:Name="SummaryButton" Classes="harvest-filter" Grid.Row="1" Grid.Column="1" Content="数据汇总" Click="SummaryClicked" />
      <Grid Grid.Row="2" Grid.ColumnSpan="3">
        <DataGrid x:Name="RecordsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" CanUserReorderColumns="True" CanUserResizeColumns="True" GridLinesVisibility="All" HeadersVisibility="Column" SelectionMode="Single" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto" RowHeight="40" ColumnHeaderHeight="36" FontSize="14" />
        <TextBlock x:Name="EmptyText" IsVisible="False" Text="当前视图暂无记录" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource SukiLowText}" IsHitTestVisible="False" />
        <ContentControl x:Name="DutyContent" IsVisible="False" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
