<UserControl
    x:Class="MFAAvalonia.Views.UserControls.Settings.SwordDropNotificationUserControl"
    x:DataType="settings:SwordDropNotificationUserControlModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calcBinding="clr-namespace:CalcBinding;assembly=CalcBindingAva"
    xmlns:settings="clr-namespace:MFAAvalonia.ViewModels.UsersControls.Settings">
    <StackPanel Spacing="12">
        <TextBlock FontSize="12" Foreground="Gray" Text="选择需要弹窗播报的刀剑。播报只对标准刀名识别成功且名单命中的掉落生效。" TextWrapping="Wrap" />
        <StackPanel x:Name="SwordSearchPanel" Spacing="4">
            <TextBox x:Name="SwordSearchBox" Text="{Binding SearchText}" GotFocus="SearchBox_OnGotFocus" Watermark="输入刀剑名称或刀种搜索…" />
            <ListBox MaxHeight="220" IsVisible="{calcBinding:Binding 'Candidates.Count > 0'}" ItemsSource="{Binding Candidates}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Padding="10,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding AddCommand}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="{Binding DisplayName}" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="12" Foreground="Gray" Text="{Binding Type}" />
                            <TextBlock Grid.Column="2" Margin="12,0,0,0" FontSize="12" Foreground="Gray" IsVisible="{calcBinding:Binding 'IsSelected'}" Text="已添加" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{calcBinding:Binding '&quot;已选（&quot; + Tags.Count + &quot;）&quot;'}" />
        <ItemsControl ItemsSource="{Binding Tags}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,3,8,3" Padding="10,3" BorderBrush="{DynamicResource SukiPrimaryColor}" BorderThickness="1" CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding DisplayName}" />
                            <Button Padding="4,0" Background="Transparent" BorderThickness="0" Command="{Binding RemoveCommand}" Content="×" FontSize="12" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
