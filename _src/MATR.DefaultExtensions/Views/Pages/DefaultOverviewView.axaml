<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MFAAvalonia.Views.Pages"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent" x:Class="MFAAvalonia.Views.Pages.DefaultOverviewView" Foreground="{DynamicResource OverviewBodyBrush}" FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OverviewSuccessBrush" Color="#21854A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="OverviewSuccessBrush" Color="#7BD5A0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="OverviewHeadingBrush" Color="{DynamicResource SukiText}" />
            <SolidColorBrush x:Key="OverviewBodyBrush" Color="{DynamicResource SukiText}" Opacity="0.88" />
            <SolidColorBrush x:Key="OverviewMutedBrush" Color="{DynamicResource SukiLowText}" />
            <SolidColorBrush x:Key="OverviewAccentBrush" Color="{DynamicResource SukiLowText}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.overview-section">
            <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{DynamicResource OverviewMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OverviewHeadingBrush}" />
        </Style>
        <Style Selector="TextBlock.overview-detail">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource OverviewBodyBrush}" />
        </Style>
        <Style Selector="TextBlock.overview-label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OverviewHeadingBrush}" />
        </Style>
        <Style Selector="TextBlock.resource-value">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource OverviewAccentBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="TextBlock.overview-running">
            <Setter Property="Foreground" Value="{DynamicResource OverviewAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.overview-idle">
            <Setter Property="Foreground" Value="{DynamicResource OverviewMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.overview-complete">
            <Setter Property="Foreground" Value="{DynamicResource OverviewSuccessBrush}" />
        </Style>
        <Style Selector="Border.overview-header-divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SukiControlBorderBrush}" />
        </Style>
        <Style Selector="Border.overview-inset">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor5}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor15}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </UserControl.Styles>
        <ScrollViewer x:Name="OverviewScroll" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="OverviewContent" Spacing="12" Margin="0,0,8,0" SizeChanged="UpdateContentLayout">
                <Border Classes="overview-section">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Text="账号资料" Classes="section-title" VerticalAlignment="Center" />
                            <TextBlock x:Name="AccountReadStatus" Grid.Column="1" Text="等待首次同步" Classes="caption" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="BasicTight" Tag="AccountCardBody" Click="ToggleCard" Width="24" Height="24" Padding="0" CornerRadius="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="{DynamicResource SukiPrimaryColor}" ToolTip.Tip="收起卡片" AutomationProperties.Name="收起账号资料">
                                <icons:FluentIcon Icon="ChevronUp" IconSize="Size16" />
                            </Button>
                        </Grid>
                        <StackPanel x:Name="AccountCardBody" Spacing="14">
                            <Border Classes="overview-header-divider" Margin="0,-6,0,0" />
                            <UniformGrid x:Name="AccountFields" Columns="3">
                                <StackPanel Spacing="6" Margin="0,0,8,10">
                                    <TextBlock Text="审神者" Classes="caption" />
                                    <TextBlock x:Name="ValuePlayerName" Text="未读取" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="6" Margin="0,0,8,10">
                                    <TextBlock Text="属国" Classes="caption" />
                                    <TextBlock x:Name="ValueCountry" Text="未读取" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="6" Margin="0,0,8,10">
                                    <TextBlock Text="审神者等级" Classes="caption" />
                                    <TextBlock x:Name="ValueLevel" Classes="resource-value" Text="未读取" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Classes="overview-section">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Text="资源摘要" Classes="section-title" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="WarehouseSyncButton" Content="同步到仓库" Click="SyncWarehouse" IsEnabled="False" Padding="12,6" ToolTip.Tip="将最近读取的资源数据保存到仓库" />
                            <Button Grid.Column="2" Classes="BasicTight" Tag="ResourcesCardBody" Click="ToggleCard" Width="24" Height="24" Padding="0" CornerRadius="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="{DynamicResource SukiPrimaryColor}" ToolTip.Tip="收起卡片" AutomationProperties.Name="收起资源摘要">
                                <icons:FluentIcon Icon="ChevronUp" IconSize="Size16" />
                            </Button>
                        </Grid>
                        <StackPanel x:Name="ResourcesCardBody" Spacing="14">
                            <Border Classes="overview-header-divider" Margin="0,-6,0,0" />
                            <UniformGrid x:Name="CoreResources" Columns="4">
                                <StackPanel Spacing="6" Margin="0,0,8,12">
                                    <TextBlock Text="木炭" Classes="caption" />
                                    <TextBlock x:Name="ValueCharcoal" Classes="resource-value" Text="未读取" />
                                </StackPanel>
                                <StackPanel Spacing="6" Margin="0,0,8,12">
                                    <TextBlock Text="玉钢" Classes="caption" />
                                    <TextBlock x:Name="ValueSteel" Classes="resource-value" Text="未读取" />
                                </StackPanel>
                                <StackPanel Spacing="6" Margin="0,0,8,12">
                                    <TextBlock Text="冷却材" Classes="caption" />
                                    <TextBlock x:Name="ValueCoolant" Classes="resource-value" Text="未读取" />
                                </StackPanel>
                                <StackPanel Spacing="6" Margin="0,0,8,12">
                                    <TextBlock Text="砥石" Classes="caption" />
                                    <TextBlock x:Name="ValueFile" Classes="resource-value" Text="未读取" />
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="3">
                                <StackPanel Spacing="6" Margin="0,0,8,0">
                                    <TextBlock Text="委托符" Classes="caption" />
                                    <TextBlock x:Name="ValueBill" Classes="resource-value" Text="未读取" />
                                </StackPanel>
                                <StackPanel Spacing="6" Margin="0,0,8,0">
                                    <TextBlock Text="加速符" Classes="caption" />
                                    <TextBlock x:Name="ValueAccelerator" Classes="resource-value" Text="未读取" />
                                </StackPanel>
                                <StackPanel Spacing="6" Margin="0,0,8,0">
                                    <TextBlock Text="小判" Classes="caption" />
                                    <TextBlock x:Name="ValueMoney" Classes="resource-value" Text="未读取" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Spacing="12">
                    <Border x:Name="TeamSection" Classes="overview-section">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="部队摘要" Classes="section-title" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="BasicTight" Tag="TeamsCardBody" Click="ToggleCard" Width="24" Height="24" Padding="0" CornerRadius="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="{DynamicResource SukiPrimaryColor}" ToolTip.Tip="收起卡片" AutomationProperties.Name="收起部队摘要">
                                    <icons:FluentIcon Icon="ChevronUp" IconSize="Size16" />
                                </Button>
                            </Grid>
                            <StackPanel x:Name="TeamsCardBody" Spacing="14">
                            <Border Classes="overview-header-divider" Margin="0,-6,0,0" />
                                <Border Classes="overview-inset">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" MinHeight="24">
                                        <TextBlock Text="部队1" Foreground="{DynamicResource OverviewHeadingBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ValueTeam1" Grid.Column="1" Text="未读取" TextWrapping="Wrap" Classes="overview-detail" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Classes="overview-inset">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" MinHeight="24">
                                        <TextBlock Text="部队2" Foreground="{DynamicResource OverviewHeadingBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ValueTeam2" Grid.Column="1" Text="未读取" TextWrapping="Wrap" Classes="overview-detail" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Classes="overview-inset">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" MinHeight="24">
                                        <TextBlock Text="部队3" Foreground="{DynamicResource OverviewHeadingBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ValueTeam3" Grid.Column="1" Text="未读取" TextWrapping="Wrap" Classes="overview-detail" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Classes="overview-inset">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" MinHeight="24">
                                        <TextBlock Text="部队4" Foreground="{DynamicResource OverviewHeadingBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ValueTeam4" Grid.Column="1" Text="未读取" TextWrapping="Wrap" Classes="overview-detail" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Classes="overview-inset">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" MinHeight="24">
                                        <TextBlock Text="部队5" Foreground="{DynamicResource OverviewHeadingBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ValueTeam5" Grid.Column="1" Text="未读取" TextWrapping="Wrap" Classes="overview-detail" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="DutySection" Classes="overview-section">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="内番" Classes="section-title" VerticalAlignment="Center" />
                                <TextBlock x:Name="ValueDuty" Grid.Column="1" Text="未读取" Classes="overview-detail" TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="BasicTight" Tag="DutyCardBody" Click="ToggleCard" Width="24" Height="24" Padding="0" CornerRadius="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="{DynamicResource SukiPrimaryColor}" ToolTip.Tip="收起卡片" AutomationProperties.Name="收起内番">
                                    <icons:FluentIcon Icon="ChevronUp" IconSize="Size16" />
                                </Button>
                            </Grid>
                            <StackPanel x:Name="DutyCardBody" Spacing="14">
                            <Border Classes="overview-header-divider" Margin="0,-6,0,0" />
                                <Border Classes="overview-inset" Padding="14">
                                    <UniformGrid Columns="3">
                                        <StackPanel Spacing="8" Margin="0,0,12,0">
                                            <TextBlock Text="饲马" Classes="overview-label" />
                                            <TextBlock x:Name="DutyHorseMembers" Text="未读取" Classes="overview-detail" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Spacing="8" Margin="0,0,12,0">
                                            <TextBlock Text="耕作" Classes="overview-label" />
                                            <TextBlock x:Name="DutyFieldMembers" Text="未读取" Classes="overview-detail" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="切磋" Classes="overview-label" />
                                            <TextBlock x:Name="DutyBoutMembers" Text="未读取" Classes="overview-detail" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ForgeSection" Classes="overview-section">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="锻刀" Classes="section-title" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="BasicTight" Tag="ForgeCardBody" Click="ToggleCard" Width="24" Height="24" Padding="0" CornerRadius="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="{DynamicResource SukiPrimaryColor}" ToolTip.Tip="收起卡片" AutomationProperties.Name="收起锻刀">
                                    <icons:FluentIcon Icon="ChevronUp" IconSize="Size16" />
                                </Button>
                            </Grid>
                            <StackPanel x:Name="ForgeCardBody" Spacing="14">
                            <Border Classes="overview-header-divider" Margin="0,-6,0,0" />
                                <Border Classes="overview-inset" Padding="14">
                                    <UniformGrid x:Name="ForgeSlots" Columns="3">
                                        <TextBlock Text="未读取" Classes="caption" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="RepairSection" Classes="overview-section">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="修刀" Classes="section-title" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="BasicTight" Tag="RepairCardBody" Click="ToggleCard" Width="24" Height="24" Padding="0" CornerRadius="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="{DynamicResource SukiPrimaryColor}" ToolTip.Tip="收起卡片" AutomationProperties.Name="收起修刀">
                                    <icons:FluentIcon Icon="ChevronUp" IconSize="Size16" />
                                </Button>
                            </Grid>
                            <StackPanel x:Name="RepairCardBody" Spacing="14">
                            <Border Classes="overview-header-divider" Margin="0,-6,0,0" />
                                <Border Classes="overview-inset" Padding="14">
                                    <UniformGrid x:Name="RepairSlots" Columns="3">
                                        <TextBlock Text="未读取" Classes="caption" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
</UserControl>
